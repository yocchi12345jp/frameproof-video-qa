{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "FrameProof Video QA",
          "informationUri": "https://github.com/yocchi12345jp/frameproof-video-qa",
          "version": "0.5.0",
          "rules": [
            {
              "id": "CAPTION_LINE_TOO_LONG",
              "name": "CAPTION_LINE_TOO_LONG",
              "shortDescription": {
                "text": "caption line too long"
              },
              "fullDescription": {
                "text": "Caption 2 has a 23-character line."
              },
              "help": {
                "text": "FrameProof rule CAPTION_LINE_TOO_LONG. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CAPTION_OVERLAP",
              "name": "CAPTION_OVERLAP",
              "shortDescription": {
                "text": "caption overlap"
              },
              "fullDescription": {
                "text": "Captions 1 and 2 overlap by 50 ms."
              },
              "help": {
                "text": "FrameProof rule CAPTION_OVERLAP. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "CAPTION_TOO_FAST",
              "name": "CAPTION_TOO_FAST",
              "shortDescription": {
                "text": "caption too fast"
              },
              "fullDescription": {
                "text": "Caption 1 requires 27.5 characters per second."
              },
              "help": {
                "text": "FrameProof rule CAPTION_TOO_FAST. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "CAPTION_TOO_SHORT",
              "name": "CAPTION_TOO_SHORT",
              "shortDescription": {
                "text": "caption too short"
              },
              "fullDescription": {
                "text": "Caption 1 is displayed for only 400 ms."
              },
              "help": {
                "text": "FrameProof rule CAPTION_TOO_SHORT. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "EXPECTED_MOTION_MISSING",
              "name": "EXPECTED_MOTION_MISSING",
              "shortDescription": {
                "text": "expected motion missing"
              },
              "fullDescription": {
                "text": "Expected motion cta-motion averaged 0.0000, below 0.02."
              },
              "help": {
                "text": "FrameProof rule EXPECTED_MOTION_MISSING. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "SAFE_AREA_VIOLATION",
              "name": "SAFE_AREA_VIOLATION",
              "shortDescription": {
                "text": "safe area violation"
              },
              "fullDescription": {
                "text": "Region cta-primary violates the declared safe area."
              },
              "help": {
                "text": "FrameProof rule SAFE_AREA_VIOLATION. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "TEXT_TOO_MANY_LINES",
              "name": "TEXT_TOO_MANY_LINES",
              "shortDescription": {
                "text": "text too many lines"
              },
              "fullDescription": {
                "text": "Declared text cta-copy uses 3 lines, above 2."
              },
              "help": {
                "text": "FrameProof rule TEXT_TOO_MANY_LINES. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "TEXT_TOO_SMALL",
              "name": "TEXT_TOO_SMALL",
              "shortDescription": {
                "text": "text too small"
              },
              "fullDescription": {
                "text": "Declared text cta-copy is 22px, below 32px."
              },
              "help": {
                "text": "FrameProof rule TEXT_TOO_SMALL. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "UNEXPECTED_SILENCE",
              "name": "UNEXPECTED_SILENCE",
              "shortDescription": {
                "text": "unexpected silence"
              },
              "fullDescription": {
                "text": "Audio is silent for 0.81 seconds from 1.00s."
              },
              "help": {
                "text": "FrameProof rule UNEXPECTED_SILENCE. Review the source-aware Fix Packet for repair guidance."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
